# Local development only. On Render, set these in the dashboard instead.
FLASK_ENV=development
PORT=3000
DATA_DIR=./data
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@gooddrinks.com.au
ADMIN_PASSWORD=at-least-ten-characters
ADMIN_NAME=Your Name
SEED_DEMO=true

# --- Microsoft 365 SSO (optional) ---
# Leave blank to disable the SSO button and use password login only.
# See README for how to register the app in Entra ID.
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_TENANT_ID=your-tenant-id-or-common
AAD_REDIRECT_URI=http://localhost:3000/auth/sso/callback
